<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.manas.opsconsole</groupId>
  <artifactId>ops-console-regression-gate-tests</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.11.3</junit.version>
    <selenium.version>4.27.0</selenium.version>
    <restassured.version>5.5.0</restassured.version>
    <groovy.version>4.0.24</groovy.version>
    <spock.version>2.3-groovy-4.0</spock.version>
    <app.baseUrl>http://localhost:4000</app.baseUrl>
    <!-- Playwright's own bundled Chromium (Chrome for Testing build), never the user's
         installed browser; see browser/package.json and ChromeDriverFactory's javadoc.
         The matching driver binary (same exact version, fetched by browser/fetch_driver.py
         straight from the Chrome for Testing dashboard) is installed inside this project
         rather than resolved by Selenium Manager, whose driver cache otherwise pins
         whatever version it first resolved regardless of the binary actually in use. -->
    <chrome.binary>${user.home}\AppData\Local\ms-playwright\chromium-1254\chrome-win64\chrome.exe</chrome.binary>
    <chrome.driver>${project.basedir}\browser\driver\chromedriver-win64\chromedriver.exe</chrome.driver>
    <rerun.count>0</rerun.count>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
      <version>${restassured.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.seleniumhq.selenium</groupId>
      <artifactId>selenium-java</artifactId>
      <version>${selenium.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Groovy and Spock: the new specification layer for the payment checkout
         flow, requested by name in the posting this slot answers. -->
    <dependency>
      <groupId>org.apache.groovy</groupId>
      <artifactId>groovy</artifactId>
      <version>${groovy.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.spockframework</groupId>
      <artifactId>spock-core</artifactId>
      <version>${spock.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- REST Assured needs a JSON mapper on the classpath to serialize a Groovy
         Map request body (used by the Spock spec's data-driven cases). -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.18.1</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>tests</finalName>
    <plugins>
      <!-- Compiles src/test/groovy (the Spock specification layer) alongside the
           regular Java test sources; addTestSources/compileTests run in the
           generate-test-sources and test-compile phases respectively. -->
      <plugin>
        <groupId>org.codehaus.gmavenplus</groupId>
        <artifactId>gmavenplus-plugin</artifactId>
        <version>3.0.2</version>
        <executions>
          <execution>
            <goals>
              <goal>addTestSources</goal>
              <goal>compileTests</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <!-- Surefire's own defaults (**/*Test.java etc.) do not match Spock's
               "*Spec" naming convention; included explicitly here alongside them. -->
          <includes>
            <include>**/*Test.java</include>
            <include>**/*Spec.java</include>
          </includes>
          <systemPropertyVariables>
            <app.baseUrl>${app.baseUrl}</app.baseUrl>
            <webdriver.chrome.binary>${chrome.binary}</webdriver.chrome.binary>
            <webdriver.chrome.driver>${chrome.driver}</webdriver.chrome.driver>
          </systemPropertyVariables>
          <trimStackTrace>false</trimStackTrace>
          <!-- Surefire's own rerun-and-quarantine mechanism: a failing test is retried up
               to this many times within the same run; if any retry passes, Surefire reports
               it as a "flake" (separate from "failures") and the run as a whole still
               succeeds. 0 by default (raw, no quarantine); the regression-flake measurement
               script overrides this with -Drerun.count=3 to measure the quarantined rate. -->
          <rerunFailingTestsCount>${rerun.count}</rerunFailingTestsCount>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
